[Unit]
Description=Protected off-host VPN registry and panel backup
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=operator
ExecStart=/usr/bin/python3 /home/operator/.local/share/vpn-max/deployment/backup.py
TimeoutStartSec=240
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/operator/.local/share/vpn-max/backups
PrivateTmp=true
UMask=0077
