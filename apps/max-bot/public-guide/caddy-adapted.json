{
  "apps": {
    "http": {
      "servers": {
        "srv0": {
          "listen": [
            ":443"
          ],
          "routes": [
            {
              "match": [
                {
                  "host": [
                    "vpn.example.net"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "subroute",
                  "routes": [
                    {
                      "group": "group5",
                      "handle": [
                        {
                          "handler": "subroute",
                          "routes": [
                            {
                              "handle": [
                                {
                                  "handler": "headers",
                                  "response": {
                                    "set": {
                                      "Cache-Control": [
                                        "public, max-age=300"
                                      ],
                                      "Content-Security-Policy": [
                                        "default-src 'none'; style-src 'unsafe-inline'; img-src data:; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
                                      ],
                                      "Referrer-Policy": [
                                        "no-referrer"
                                      ],
                                      "X-Content-Type-Options": [
                                        "nosniff"
                                      ],
                                      "X-Frame-Options": [
                                        "DENY"
                                      ]
                                    }
                                  }
                                }
                              ]
                            },
                            {
                              "group": "group0",
                              "handle": [
                                {
                                  "handler": "rewrite",
                                  "uri": "/guide.html"
                                }
                              ]
                            },
                            {
                              "handle": [
                                {
                                  "handler": "reverse_proxy",
                                  "upstreams": [
                                    {
                                      "dial": "frontend:80"
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ],
                      "match": [
                        {
                          "method": [
                            "GET",
                            "HEAD"
                          ],
                          "path": [
                            "/guide",
                            "/guide/"
                          ]
                        }
                      ]
                    },
                    {
                      "group": "group5",
                      "handle": [
                        {
                          "handler": "subroute",
                          "routes": [
                            {
                              "handle": [
                                {
                                  "handler": "static_response",
                                  "status_code": 405
                                }
                              ],
                              "match": [
                                {
                                  "not": [
                                    {
                                      "method": [
                                        "POST"
                                      ]
                                    }
                                  ]
                                }
                              ]
                            },
                            {
                              "handle": [
                                {
                                  "handler": "reverse_proxy",
                                  "upstreams": [
                                    {
                                      "dial": "vpn-max:8088"
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ],
                      "match": [
                        {
                          "path": [
                            "/webhook/max"
                          ]
                        }
                      ]
                    },
                    {
                      "group": "group5",
                      "handle": [
                        {
                          "handler": "subroute",
                          "routes": [
                            {
                              "handle": [
                                {
                                  "body": "Forbidden",
                                  "handler": "static_response",
                                  "status_code": 403
                                }
                              ],
                              "match": [
                                {
                                  "not": [
                                    {
                                      "remote_ip": {
                                        "ranges": [
                                          "192.0.2.50",
                                          "203.0.113.10"
                                        ]
                                      }
                                    }
                                  ]
                                }
                              ]
                            },
                            {
                              "handle": [
                                {
                                  "handler": "reverse_proxy",
                                  "upstreams": [
                                    {
                                      "dial": "frontend:80"
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ],
              "terminal": true
            }
          ],
          "automatic_https": {
            "disable_redirects": true
          },
          "strict_sni_host": true
        },
        "srv1": {
          "listen": [
            ":80"
          ],
          "routes": [
            {
              "handle": [
                {
                  "handler": "subroute",
                  "routes": [
                    {
                      "group": "group7",
                      "handle": [
                        {
                          "handler": "subroute",
                          "routes": [
                            {
                              "handle": [
                                {
                                  "handler": "static_response",
                                  "headers": {
                                    "Location": [
                                      "https://vpn.example.net{http.request.uri}"
                                    ]
                                  },
                                  "status_code": 308
                                }
                              ]
                            }
                          ]
                        }
                      ],
                      "match": [
                        {
                          "host": [
                            "vpn.example.net"
                          ],
                          "remote_ip": {
                            "ranges": [
                              "192.0.2.50",
                              "203.0.113.10"
                            ]
                          }
                        }
                      ]
                    },
                    {
                      "group": "group7",
                      "handle": [
                        {
                          "handler": "subroute",
                          "routes": [
                            {
                              "handle": [
                                {
                                  "body": "Not Found",
                                  "handler": "static_response",
                                  "status_code": 404
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ],
              "terminal": true
            }
          ],
          "automatic_https": {
            "disable_redirects": true
          },
          "strict_sni_host": true
        }
      }
    },
    "tls": {
      "automation": {
        "policies": [
          {
            "subjects": [
              "vpn.example.net"
            ],
            "issuers": [
              {
                "ca": "https://acme-v02.api.letsencrypt.org/directory",
                "challenges": {
                  "tls-alpn": {
                    "disabled": true
                  }
                },
                "module": "acme"
              }
            ]
          }
        ]
      }
    }
  }
}
