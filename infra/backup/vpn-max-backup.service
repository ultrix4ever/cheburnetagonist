[Unit]
Description=Protected off-host VPN registry and panel backup
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
# Site value VPN_MAX_BACKUP_SSH lives in the drop-in vpn-max-backup.service.d/site.conf
ExecStart=/usr/bin/python3 /usr/local/lib/vpn-max/backup.py
TimeoutStartSec=240
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/root/.local/share/vpn-max/backups
PrivateTmp=true
UMask=0077
