Host zelvi-jump
    HostName 192.0.2.10
    User maxjump
Host max-relay
    HostName 203.0.113.30
    User maxrelay
    ProxyJump zelvi-jump
Host *
    IdentityFile /var/lib/maxtunnel/.ssh/id_ed25519
    IdentitiesOnly yes
    BatchMode yes
    StrictHostKeyChecking yes
    HostKeyAlgorithms ssh-ed25519
    ConnectTimeout 15
    ServerAliveInterval 15
    ServerAliveCountMax 3
    ExitOnForwardFailure yes
